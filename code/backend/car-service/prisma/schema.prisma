generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Explicit so the output is identical on every platform (no .ts import extensions / CJS surprises)
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model Car {
  id          String   @id @default(uuid())
  // Id of the user in the auth database. No foreign key, that database belongs to another service.
  sellerId    Int      @default(0) @map("seller_id")
  make        String
  model       String
  year        Int
  color       String
  mileage     Int
  // EXCELLENT, GOOD or FAIR (CAR-02)
  condition   String   @default("GOOD")
  description String   @default("")
  // Estimated value in euros
  price       Float
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("cars")
}
