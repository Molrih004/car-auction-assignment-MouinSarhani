generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Explicit so the output is identical on every platform (no .ts import extensions / CJS surprises)
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String   @default("")
  passwordHash String   @map("password_hash")
  // BUYER, SELLER or STAFF (ACC-03). STAFF can't be chosen when registering.
  role         String   @default("BUYER")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}
